# Neon PostgreSQL — get both URLs from neon.tech dashboard
# "Pooled connection" string goes in DATABASE_URL
# "Direct connection" string goes in DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Set to your Vercel deployment URL (no trailing slash)
NEXTAUTH_URL="https://your-app.vercel.app"
